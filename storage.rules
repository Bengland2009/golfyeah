rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors firestore.rules' membership check, using Storage rules' ability
    // to read Firestore data at evaluation time.
    function isMember(groupId) {
      return request.auth != null &&
        request.auth.token.email in
          firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberEmails;
    }

    match /groups/{groupId}/photos/{fileName} {
      allow read: if isMember(groupId);
      // request.resource is null on delete, so that path skips the size/type check.
      allow write: if isMember(groupId) &&
        (request.resource == null ||
          (request.resource.size < 5 * 1024 * 1024 &&
           request.resource.contentType.matches('image/.*')));
    }
  }
}
