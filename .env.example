# Copy this file to .env and fill in your Firebase project's web app config.
# Without these, Golfyeah! runs in local demo mode (data kept in this browser only).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: id of the shared private group document. Defaults to "default".
VITE_GOLFYEAH_GROUP_ID=
